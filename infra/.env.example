# Environment variables for local development

# ==================== DATABASE ====================
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=imda_policy
DATABASE_URL=postgresql://user:password@postgres:5432/imda_policy

# ==================== REDIS ====================
REDIS_URL=redis://redis:6379/0

# ==================== APPLICATION ====================
ENVIRONMENT=development
APP_NAME=IMDA Agentic Policy Analytics
APP_VERSION=0.1.0

# ==================== LLM PROVIDERS ====================

# OpenAI (Primary)
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_ORG_ID=org-your-org-id

# Anthropic Claude (Fallback)
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# AWS Bedrock (Optional)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# ==================== LLM CONFIGURATION ====================
LLM_PRIMARY_PROVIDER=openai
LLM_PRIMARY_MODEL=gpt-4-turbo-preview
LLM_FALLBACK_PROVIDER=anthropic
LLM_FALLBACK_MODEL=claude-3-sonnet-20240229
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Temperature settings per agent (0.0=deterministic, 1.0=creative)
LLM_COORDINATOR_TEMPERATURE=0.2
LLM_EXTRACTION_TEMPERATURE=0.0
LLM_ANALYTICS_TEMPERATURE=0.3
LLM_REPORT_TEMPERATURE=0.5

# Cost control
LLM_DAILY_BUDGET_USD=50.0
LLM_ENABLE_COST_TRACKING=true

# ==================== DATA SOURCES ====================
DATAGOV_API_KEY=your-datagov-key
DOS_SINGSTAT_URL=https://tablebuilder.singstat.gov.sg
INTERNAL_DB_ENABLED=true

# ==================== FEATURES ====================
ENABLE_PLAN_REVIEW=true
ENABLE_PARTIAL_RESULTS=true
ENABLE_VISUALIZATION=true
ENABLE_PDF_EXPORT=false
